#: data/campaigns/The_South_Guard/scenarios/01_Born_to_the_Banner.cfg:33
#: data/campaigns/The_South_Guard/scenarios/02_Proven_by_the_Sword.cfg:32
#: data/campaigns/The_South_Guard/scenarios/02x_Westin.cfg:26
#: data/campaigns/The_South_Guard/scenarios/03_Vale_of_Tears.cfg:30
#: data/campaigns/The_South_Guard/scenarios/04_Choice_in_the_Fog.cfg:34
#: data/campaigns/The_South_Guard/scenarios/05a_The_Long_March.cfg:32
