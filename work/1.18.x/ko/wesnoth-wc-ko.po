msgstr "암살자의 반지"

#. [artifact]
#: data/campaigns/World_Conquest/resources/data/artifacts.cfg:30
msgid "melee: backstab"
msgstr "근접: 백스탭"

#. [artifact]
#: data/campaigns/World_Conquest/resources/data/artifacts.cfg:31
