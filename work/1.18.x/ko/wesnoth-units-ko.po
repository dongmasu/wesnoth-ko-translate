msgid "Bowmanship Training"
msgstr "궁술 훈련"

#. [advancement]: id=strong_shots
#: data/campaigns/Under_the_Burning_Suns/units/quenoth/Youth.cfg:230
msgid "Strong Shots"
msgstr "강한 사격"

