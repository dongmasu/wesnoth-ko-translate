#. [unit]: type=Dwarvish Scout
#: data/multiplayer/scenarios/2p_Hornshark_Island.cfg:569
msgid "Rublok"
msgstr "루블록(Rublok)"

#. [unit]: type=Dwarvish Scout
#: data/multiplayer/scenarios/2p_Hornshark_Island.cfg:592
msgid "Ulysses Mantyjuuri"
msgstr "율리시스 만티유우리"

